% Style des figures du cours « Conteneurs et Kubernetes » (direction Quai).
% Traits fins colorés, remplissages très pâles, aucune ombre, aucune icône.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{quai}

\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,fit,calc,backgrounds,shapes.geometric,decorations.pathreplacing}

\input{quai-couleurs.tex}

% Polices du site, fournies dans figures/fonts
\setmainfont{AtkinsonNext}[
  Path=../fonts/, Extension=.ttf,
  UprightFont=*-Regular, BoldFont=*-Bold, ItalicFont=*-Italic]
\setmonofont{RedHatMono}[
  Path=../fonts/, Extension=.ttf,
  UprightFont=*-Regular, BoldFont=*-Medium]
\newfontfamily\titrefig{BarlowCondensed}[
  Path=../fonts/, Extension=.ttf,
  UprightFont=*-SemiBold, BoldFont=*-Bold]

\color{QInk}
% pas de césure dans les schémas
\hyphenpenalty=10000 \exhyphenpenalty=10000

\tikzset{
  % boîte générique : trait coloré, fond pâle
  qbox/.style={draw=QLine, line width=0.8pt, fill=QPaper, rounded corners=1.5pt,
    inner sep=6pt, font=\small, text=QInk, align=center},
  % boîte de composant logiciel (nom en police à chasse fixe)
  qcomp/.style={qbox, font=\ttfamily\footnotesize},
  % enveloppe (machine, conteneur, nœud) : titre posé en haut à gauche
  qcadre/.style={draw=QLine, line width=0.8pt, fill=QPaper, rounded corners=1.5pt},
  qtitre/.style={font=\titrefig\large, text=QInk, anchor=north west, inner sep=0pt},
  qlbl/.style={font=\footnotesize, text=QMuted},
  qlblc/.style={font=\footnotesize, text=#1},
  % flèches fines
  qarr/.style={-{Stealth[length=2.4mm,width=1.8mm]}, line width=0.8pt, draw=QLine},
  qdarr/.style={qarr, dashed},
  qbiarr/.style={{Stealth[length=2.4mm,width=1.8mm]}-{Stealth[length=2.4mm,width=1.8mm]}, line width=0.8pt, draw=QLine},
  % pastille numérotée pour les étapes d'une séquence
  qnum/.style={circle, fill=#1, text=QPaper, font=\titrefig\small, inner sep=1.2pt, minimum size=4.6mm},
}
\endinput
